# =====================================================================
# Trinity — TSA / Coolify deployment env template
# =====================================================================
# Use with: docker-compose.prod.yml on branch `tsa-coolify`.
#
# PRINCIPLE: nothing host-specific is hardcoded in the compose file. Every
# value below has a sane default baked into docker-compose.prod.yml, so in
# Coolify you ONLY need to set the SECRETS and anything you want to override.
# Set these as Coolify environment variables (not by editing files).
#
# Legend:
#   [SECRET]   = sensitive; set in Coolify "secret" env, never commit a value
#   [REQUIRED] = compose render FAILS (`:?`) or app won't work without it
#   [DEFAULTED]= has a working default in compose; override only if needed
# =====================================================================


# ---------------------------------------------------------------------
# CORE REQUIRED SECRETS  (no working default — you MUST provide these)
# ---------------------------------------------------------------------

# JWT signing key.  Generate: openssl rand -hex 32
SECRET_KEY=                          # [SECRET][REQUIRED]

# Admin login password + MCP legacy auth. Compose render fails if unset.
ADMIN_PASSWORD=                      # [SECRET][REQUIRED]
ADMIN_USERNAME=admin                 # [DEFAULTED]

# Scheduler<->backend shared secret (C-003). Generate: openssl rand -hex 32
INTERNAL_API_SECRET=                 # [SECRET][REQUIRED]

# Encrypts stored OAuth tokens / subscription creds. Generate: openssl rand -hex 32
# If lost, all encrypted credentials are unrecoverable.
CREDENTIAL_ENCRYPTION_KEY=           # [SECRET] (compose defaults to empty; set for prod)

# Redis auth — BOTH mandatory (compose render fails if unset).
# Generate each: openssl rand -hex 24
REDIS_PASSWORD=                      # [SECRET][REQUIRED] admin/default ACL user
REDIS_BACKEND_PASSWORD=              # [SECRET][REQUIRED] backend+scheduler runtime user

# Anthropic API key — required for agents to use Claude (can also be set in
# Settings after login, but recommended via env for prod).
ANTHROPIC_API_KEY=                   # [SECRET][REQUIRED for agents]

# Gemini-powered agents / image-gen (optional features).
GOOGLE_API_KEY=                      # [SECRET] for Gemini-powered agents
GEMINI_API_KEY=                      # [SECRET] platform image generation (IMG-001)

# GitHub PAT (classic, 'repo' scope) for cloning private template repos.
GITHUB_PAT=                          # [SECRET][REQUIRED for private templates]


# ---------------------------------------------------------------------
# TSA / COOLIFY — NEW vars introduced by docker-compose.prod.yml (tsa-coolify)
# ---------------------------------------------------------------------

# Public domain Traefik routes to this stack.
#   /        -> frontend (nginx :8080)
#   /api     -> backend  (:8000)
#   /mcp     -> mcp-server (:8080)
# DEFAULT in compose: trinity.tsunamiautomation.com
TRINITY_DOMAIN=trinity.tsunamiautomation.com          # [DEFAULTED]

# Traefik TLS cert resolver name. Must match the resolver Coolify's Traefik
# defines (Coolify's default is usually `letsencrypt`). DEFAULT: letsencrypt
TRINITY_CERT_RESOLVER=letsencrypt                      # [DEFAULTED]

# Docker network subnets — env-driven so they DON'T collide with existing
# TSA01 docker networks (upstream hardcoded 172.29.0.0/16 + 172.28.0.0/16,
# which collide on TSA01). Defaults below are free on TSA01.
# NOTE: the network *names* (trinity-platform-network / trinity-agent-network)
# are fixed in compose because backend code references them — do not change.
TRINITY_PLATFORM_SUBNET=172.16.0.0/16                  # [DEFAULTED]
TRINITY_AGENT_SUBNET=10.50.0.0/16                      # [DEFAULTED]

# Host bind-mount for /data (trinity.db, log archives, agent file shares).
# TSA01 root disk is full → data MUST live on /mnt/tsa-runtime.
# DEFAULT in compose: /mnt/tsa-runtime/trinity-data
TRINITY_DATA_PATH=/mnt/tsa-runtime/trinity-data        # [DEFAULTED]

# Docker socket group id. TSA01 docker GID is 988 (upstream default was 999).
# DEFAULT in compose: 988. Verify with: getent group docker
DOCKER_GID=988                                         # [DEFAULTED]


# ---------------------------------------------------------------------
# LOCAL MODELS via LiteLLM  (optional passthrough — staged, see note)
# ---------------------------------------------------------------------
# To point AGENT containers at our self-hosted LiteLLM gateway (local models),
# set a base URL here. The compose forwards both vars to the PLATFORM backend,
# but the backend does NOT yet copy a base URL into the per-agent env dict it
# builds in code. Forwarding it to agents is a ONE-LINE backend change at:
#   src/backend/services/agent_service/crud.py:475   (initial create)
#   src/backend/services/agent_service/lifecycle.py:377 (recreate path)
# where ANTHROPIC_API_KEY is injected via get_anthropic_api_key(). Add e.g.
#   'ANTHROPIC_BASE_URL': os.getenv('AGENT_ANTHROPIC_BASE_URL') or os.getenv('ANTHROPIC_BASE_URL')
# next to it. (No base-URL var is forwarded to agents today.)
#
# ANTHROPIC_BASE_URL          — used by the PLATFORM process if it talks to Claude directly.
# AGENT_ANTHROPIC_BASE_URL    — intended for agent containers once the forward above is added.
# Example LiteLLM endpoint on TSA: https://litellm.tsunamiautomation.com
ANTHROPIC_BASE_URL=                                    # [DEFAULTED empty]
AGENT_ANTHROPIC_BASE_URL=                              # [DEFAULTED empty]


# ---------------------------------------------------------------------
# PER-AGENT RESOURCE DEFAULTS  (NOT in compose — backend DB settings)
# ---------------------------------------------------------------------
# Per-agent CPU/MEM defaults are NOT set in docker-compose. They live in
# backend code as constants, overridable at runtime via DB settings:
#   src/backend/services/settings_service.py:434-435
#       AGENT_DEFAULT_CPU    = "2"
#       AGENT_DEFAULT_MEMORY = "4g"
#   Read by get_agent_default_resources() (settings_service.py:438), which
#   prefers DB settings keys 'agent_default_cpu' / 'agent_default_memory'.
#   Applied at container create: crud.py:737-741 (mem_limit / nano_cpus);
#   recreate path: lifecycle.py:550-554; label fallback: helpers.py:479-480.
#
# RECOMMENDED for the tight TSA01 host: reduce to 1 CPU / 1g per agent.
# Because these read from DB settings (not env), set them either:
#   (a) in the Trinity UI: Settings → agent default resources, or
#   (b) via the settings API / DB, OR
#   (c) make settings_service.py read these env vars (small backend change),
#       then set AGENT_DEFAULT_CPU / AGENT_DEFAULT_MEMORY here.
# The names below are documented so they can be wired through later:
AGENT_DEFAULT_CPU=1                                    # informational (UI/DB-driven today)
AGENT_DEFAULT_MEMORY=1g                                # informational (UI/DB-driven today)


# ---------------------------------------------------------------------
# OPTIONAL — public access / tunnel
# ---------------------------------------------------------------------
# With Coolify/Traefik fronting TRINITY_DOMAIN you typically do NOT need the
# Cloudflare tunnel. Leave TUNNEL_TOKEN empty and don't use --profile tunnel.

# Public chat URL (defaults empty; set if sharing public links outside VPN).
PUBLIC_CHAT_URL=                                       # [DEFAULTED empty]

# Frontend URL for OAuth/email links. Compose defaults this to
# https://${TRINITY_DOMAIN}; override only for a different external host.
FRONTEND_URL=                                          # [DEFAULTED -> https://TRINITY_DOMAIN]

# Cloudflare tunnel token (only if using --profile tunnel).
TUNNEL_TOKEN=                                          # [SECRET][optional]


# ---------------------------------------------------------------------
# OPTIONAL — email / OAuth providers (set only what you use)
# ---------------------------------------------------------------------
EMAIL_PROVIDER=resend                                  # console|smtp|sendgrid|resend
RESEND_API_KEY=                                        # [SECRET] if EMAIL_PROVIDER=resend
SENDGRID_API_KEY=                                      # [SECRET] if EMAIL_PROVIDER=sendgrid
SMTP_HOST=                                             # if EMAIL_PROVIDER=smtp
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=                                         # [SECRET] if EMAIL_PROVIDER=smtp
SMTP_FROM=noreply@trinity.tsunamiautomation.com

GOOGLE_CLIENT_ID=                                      # Google Workspace MCP
GOOGLE_CLIENT_SECRET=                                  # [SECRET]
SLACK_CLIENT_ID=                                       # Slack MCP
SLACK_CLIENT_SECRET=                                   # [SECRET]
SLACK_SIGNING_SECRET=                                  # [SECRET]
GITHUB_CLIENT_ID=                                      # GitHub MCP OAuth
GITHUB_CLIENT_SECRET=                                  # [SECRET]
NOTION_CLIENT_ID=                                      # Notion MCP
NOTION_CLIENT_SECRET=                                  # [SECRET]


# ---------------------------------------------------------------------
# OPTIONAL — feature flags / telemetry (compose has working defaults)
# ---------------------------------------------------------------------
VOICE_ENABLED=true                                     # [DEFAULTED]
WORKSPACE_ENABLED=false                                # [DEFAULTED] BETA (#860)
VOIP_ENABLED=false                                     # [DEFAULTED]
OTEL_ENABLED=0                                         # [DEFAULTED] (0 = off)
MCP_REQUIRE_API_KEY=true                               # [DEFAULTED]
TRINITY_USERNAME=admin                                 # [DEFAULTED]

# Build provenance (set by CI; default "unknown")
VERSION=
GIT_COMMIT=
GIT_BRANCH=
BUILD_DATE=
